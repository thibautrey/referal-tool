{
  "name": "referal-tool-backend",
  "version": "1.0.0",
  "description": "Backend API for referal tool",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc --noEmitOnError ",
    "test": "echo \"Error: no test specified\" && exit 1",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name",
    "prisma:studio": "prisma studio",
    "prisma:reset": "prisma migrate reset --force",
    "seed": "ts-node prisma/seed.ts"
  },
  "keywords": [
    "node",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@braintree/sanitize-url": "^7.1.1",
    "@prisma/client": "^6.5.0",
    "bcrypt": "^5.1.1",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "he": "^1.2.0",
    "helmet": "^7.2.0",
    "ioredis": "^5.6.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-ipinfo": "^4.0.1",
    "nodemailer": "^6.10.0",
    "proxy-chain": "^2.5.8",
    "resend": "^4.2.0",
    "speakeasy": "^2.0.0",
    "validator": "^13.15.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
