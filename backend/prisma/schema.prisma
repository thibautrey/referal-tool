// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mysql" // Vous pouvez le changer en "mysql" ou "sqlite" selon vos besoins
    url      = env("DATABASE_URL")
}

model User {
    id                 Int             @id @default(autoincrement())
    email              String          @unique
    firstName          String?
    lastName           String?
    password           String
    role               Role            @default(USER)
    active             Boolean         @default(true)
    otpEnabled         Boolean         @default(false) // Indique si l'OTP est activé
    otpSecret          String? // Clé secrète pour l'OTP (nullable car optionnel)
    otpVerified        Boolean         @default(false) // Indique si l'OTP a été vérifié
    otpBackupCodes     String? // Pour stocker les codes de secours (JSON formaté)
    seenTips           String? // Store seen tips IDs as JSON array
    theme              String?         @default("system") // Added theme preference
    lastProjectId      Int? // Added to store the last selected project
    projects           Project[]       @relation("OwnedProjects")
    projectMemberships ProjectMember[]
    apiKeys            ApiKey[]
    createdAt          DateTime        @default(now())
    updatedAt          DateTime        @updatedAt
}

model Project {
    id          Int             @id @default(autoincrement())
    name        String
    description String?
    user        User            @relation("OwnedProjects", fields: [userId], references: [id])
    userId      Int
    members     ProjectMember[]
    links       Link[]
    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @updatedAt

    @@index([userId])
}

model ProjectMember {
    id        Int               @id @default(autoincrement())
    project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
    projectId Int
    user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId    Int
    role      ProjectMemberRole @default(MEMBER)
    createdAt DateTime          @default(now())

    @@unique([projectId, userId])
    @@index([userId])
}

enum ProjectMemberRole {
    MEMBER
    ADMIN
}

model Link {
    id                  Int          @id @default(autoincrement())
    name                String
    baseUrl             String
    shortCode           String       @unique // Code court unique pour l'URL
    project             Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
    projectId           Int
    rules               LinkRule[]
    deviceRules         DeviceRule[]
    active              Boolean      @default(true)
    isPasswordProtected Boolean      @default(false)
    passwordHash        String?
    // UTM Parameters
    utmSource           String?
    utmMedium           String?
    utmCampaign         String?
    utmTerm             String?
    utmContent          String?
    createdAt           DateTime     @default(now())
    updatedAt           DateTime     @updatedAt
    LinkVisit           LinkVisit[]

    @@index([projectId])
}

model LinkRule {
    id          Int         @id @default(autoincrement())
    redirectUrl String
    countries   String // Stocké en JSON comme liste de codes pays
    link        Link        @relation(fields: [linkId], references: [id], onDelete: Cascade)
    linkId      Int
    createdAt   DateTime    @default(now())
    updatedAt   DateTime    @updatedAt
    LinkVisit   LinkVisit[]

    @@index([linkId])
}

model DeviceRule {
    id          Int         @id @default(autoincrement())
    redirectUrl String
    deviceType  String // "mobile", "desktop", "tablet", "all"
    devices     String // JSON string of specific devices
    link        Link        @relation(fields: [linkId], references: [id], onDelete: Cascade)
    linkId      Int
    createdAt   DateTime    @default(now())
    updatedAt   DateTime    @updatedAt
    LinkVisit   LinkVisit[]

    @@index([linkId])
}

model IpCountryCache {
    ip          String   @id
    countryCode String
    city        String?
    expiresAt   DateTime
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@index([expiresAt])
}

model LinkVisit {
    id           Int         @id @default(autoincrement())
    link         Link        @relation(fields: [linkId], references: [id], onDelete: Cascade)
    linkId       Int
    ip           String?
    country      String
    city         String?
    rule         LinkRule?   @relation(fields: [ruleId], references: [id], onDelete: SetNull)
    ruleId       Int?
    deviceRule   DeviceRule? @relation(fields: [deviceRuleId], references: [id], onDelete: SetNull)
    deviceRuleId Int?
    userAgent    String?
    deviceType   String?
    createdAt    DateTime    @default(now())

    @@index([linkId])
    @@index([ip])
    @@index([ruleId])
    @@index([deviceRuleId])
}

model ApiKey {
    id        Int      @id @default(autoincrement())
    name      String
    key       String   @unique
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId    Int
    primaryAiProvider   AiProvider? @relation("ApiKeyPrimaryProvider", fields: [primaryAiProviderId], references: [id])
    primaryAiProviderId Int?
    primaryAiModel      AiModel?    @relation("ApiKeyPrimaryModel", fields: [primaryAiModelId], references: [id])
    primaryAiModelId    Int?
    createdAt DateTime @default(now())
}

model AiProvider {
    id                  Int        @id @default(autoincrement())
    name                String     @unique
    baseUrl             String?
    inputTokenPrice     Decimal?   @db.Decimal(18, 8)
    outputTokenPrice    Decimal?   @db.Decimal(18, 8)
    fallbackProvider    AiProvider? @relation("AiProviderFallback", fields: [fallbackProviderId], references: [id])
    fallbackProviderId  Int?
    fallbackFor         AiProvider[] @relation("AiProviderFallback")
    models              AiModel[]
    apiKeys             ApiKey[]   @relation("ApiKeyPrimaryProvider")
    createdAt           DateTime   @default(now())
    updatedAt           DateTime   @updatedAt
}

model AiModel {
    id                Int        @id @default(autoincrement())
    name              String
    modelIdentifier   String?
    baseUrl           String?
    inputTokenPrice   Decimal?   @db.Decimal(18, 8)
    outputTokenPrice  Decimal?   @db.Decimal(18, 8)
    provider          AiProvider @relation(fields: [providerId], references: [id])
    providerId        Int
    fallbackModel     AiModel?   @relation("AiModelFallback", fields: [fallbackModelId], references: [id])
    fallbackModelId   Int?
    fallbackFor       AiModel[]  @relation("AiModelFallback")
    apiKeys           ApiKey[]   @relation("ApiKeyPrimaryModel")
    createdAt         DateTime   @default(now())
    updatedAt         DateTime   @updatedAt
}

enum Role {
    USER
    ADMIN
}
